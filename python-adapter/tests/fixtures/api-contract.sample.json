{
  "openapi": "3.1.0",
  "info": {
    "title": "JsonHub API",
    "version": "0.9.3",
    "description": "Sample API Contract for the Python SDK Target's conformance suite: a stand-in for the JsonHub API, carrying the shapes the conformance suite asserts on - several representations per operation, a HAL collection envelope, JSON-LD and JSON:API variants. src/normalizer.mjs reduces it to canonical-client-spec.sample.json (`npm run write-conformance-fixture`)."
  },
  "paths": {
    "/api/definitions": {
      "get": {
        "operationId": "listDefinitions",
        "responses": {
          "200": {
            "description": "Collection",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/DefinitionCollection.jsonld"
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Definition"
                  }
                }
              },
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/DefinitionCollection"
                }
              },
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error.jsonld"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createDefinition",
        "requestBody": {
          "content": {
            "application/ld+json": {
              "schema": {
                "$ref": "#/components/schemas/Definition.jsonld"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Definition"
              }
            },
            "application/hal+json": {
              "schema": {
                "$ref": "#/components/schemas/Definition.jsonhal"
              }
            },
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition.jsonld"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition"
                }
              },
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition.jsonhal"
                }
              },
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/entities/{id}": {
      "get": {
        "operationId": "getEntity",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entity - the definition relation is a direct property in the plain JSON representation, and moves under _links/_embedded in the HAL one",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity.jsonld"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              },
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity.jsonhal"
                }
              },
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error.jsonld"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/definitions/{id}": {
      "get": {
        "operationId": "getDefinition",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Definition",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition.jsonld"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition"
                }
              },
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition.jsonhal"
                }
              },
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error.jsonld"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchDefinition",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/DefinitionPatch"
              }
            },
            "application/vnd.api+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition.jsonld"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition"
                }
              },
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition.jsonhal"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Definition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Definition.jsonld": {
        "type": "object",
        "properties": {
          "@id": {
            "type": "string"
          },
          "@type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Definition.jsonhal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "_links": {
            "type": "object"
          }
        }
      },
      "DefinitionPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "DefinitionCollection": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HalCollectionBase"
          },
          {
            "type": "object",
            "properties": {
              "_embedded": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Definition.jsonhal"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "DefinitionCollection.jsonld": {
        "type": "object",
        "properties": {
          "@context": {
            "type": "string"
          },
          "hydra:member": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Definition.jsonld"
            }
          }
        }
      },
      "HalCollectionBase": {
        "type": "object",
        "properties": {
          "totalItems": {
            "type": "integer"
          },
          "itemsPerPage": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "_links": {
            "type": "object"
          },
          "_embedded": {
            "type": "object",
            "properties": {
              "item": {
                "type": "array"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Error.jsonld": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Entity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "definition": {
            "$ref": "#/components/schemas/Definition"
          }
        }
      },
      "Entity.jsonld": {
        "type": "object",
        "properties": {
          "@id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "definition": {
            "$ref": "#/components/schemas/Definition.jsonld"
          }
        }
      },
      "Entity.jsonhal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "_links": {
            "type": "object"
          },
          "_embedded": {
            "type": "object"
          }
        }
      }
    }
  }
}
