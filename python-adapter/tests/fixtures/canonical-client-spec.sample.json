{
  "openapi": "3.1.0",
  "info": {
    "title": "JsonHub API",
    "version": "0.9.3",
    "description": "Sample API Contract for the Python SDK Target's conformance suite: a stand-in for the JsonHub API, carrying the shapes the conformance suite asserts on - several representations per operation, a HAL collection envelope, JSON-LD and JSON:API variants. It also carries the shapes the ts runtime suite asserts on: an oauth2-secured operation and an http/bearer-secured one, a HAL collection whose item schema declares createdAt and _links, and POST/PATCH operations whose plain-JSON representation inlines a relation. src/normalizer.mjs reduces it to canonical-client-spec.sample.json (`npm run write-conformance-fixture`)."
  },
  "paths": {
    "/api/definitions": {
      "get": {
        "operationId": "listDefinitions",
        "security": [
          {
            "oauth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "Collection",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/DefinitionCollection"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/hal+json"
            }
          }
        ]
      },
      "post": {
        "operationId": "createDefinition",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Definition"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/json"
            }
          }
        ]
      }
    },
    "/api/entities": {
      "post": {
        "operationId": "createEntity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Entity"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created - the definition relation is a direct property in the plain JSON representation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/json"
            }
          }
        ]
      }
    },
    "/api/entities/{id}": {
      "get": {
        "operationId": "getEntity",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entity - the definition relation is a direct property in the plain JSON representation, and moves under _links/_embedded in the HAL one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchEntity",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/json"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/EntityPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated - the definition relation is a direct property in the plain JSON representation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            }
          }
        }
      }
    },
    "/api/definitions/{id}": {
      "get": {
        "operationId": "getDefinition",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Definition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchDefinition",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/json"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/DefinitionPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Definition"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Definition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Definition.jsonhal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "_links": {
            "type": "object"
          }
        }
      },
      "DefinitionPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "DefinitionCollection": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HalCollectionBase"
          },
          {
            "type": "object",
            "properties": {
              "_embedded": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Definition.jsonhal"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "HalCollectionBase": {
        "type": "object",
        "properties": {
          "totalItems": {
            "type": "integer"
          },
          "itemsPerPage": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "_links": {
            "type": "object"
          },
          "_embedded": {
            "type": "object",
            "properties": {
              "item": {
                "type": "array",
                "items": {}
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Entity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "definition": {
            "$ref": "#/components/schemas/Definition"
          }
        }
      },
      "EntityPatch": {
        "type": "object",
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/Definition"
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {
              "read": "Read access",
              "write": "Write access"
            }
          }
        }
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
